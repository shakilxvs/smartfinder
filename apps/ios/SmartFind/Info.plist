<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>SmartFind looks for your home SmartFind server on the same Wi-Fi network so it can be found and messaged from your other devices.</string>

    <key>NSBonjourServices</key>
    <array>
        <string>_smartfind._tcp</string>
    </array>

    <key>UIBackgroundModes</key>
    <array>
        <!-- audio: lets a ring already in progress keep playing for a few
             seconds if the app is briefly backgrounded mid-ring. This is
             NOT a general-purpose background execution grant and does not
             let SmartFind receive new commands while backgrounded - see
             docs/ios-limitations.md. -->
        <string>audio</string>
    </array>

    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
